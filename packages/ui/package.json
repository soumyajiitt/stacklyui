{
  "name": "@stacklyui/ui",
  "version": "0.1.0",
  "description": "Beautifully animated, accessible React components for building standout interfaces.",
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "motion",
    "animation",
    "stacklyui"
  ],
  "license": "MIT",
  "author": "Soumyajit Basak",
  "homepage": "https://dev.stacklyui.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soumyajiitt/stacklyui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/soumyajiitt/stacklyui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "radix-ui": "1.4.3",
    "tailwind-merge": "3.3.1"
  },
  "peerDependencies": {
    "motion": ">=11",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "motion": "12.23.24",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsup": "8.5.0",
    "typescript": "5.9.2"
  }
}
